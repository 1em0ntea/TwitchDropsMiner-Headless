[Unit]
Description=Twitch Drops Miner Headless
Documentation=file:/opt/twitchdropsminer/docs/vps-deployment.md
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=tdm
Group=tdm
WorkingDirectory=/opt/twitchdropsminer

Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=TDM_DATA_DIR=/var/lib/twitchdropsminer
Environment=TDM_WEB_HOST=127.0.0.1
Environment=TDM_WEB_PORT=5800
Environment=TDM_WEB_USERNAME=admin
Environment=TDM_WEB_PASSWORD_FILE=/etc/twitchdropsminer/web_password
Environment=TDM_WEB_COOKIE_SECURE=true
Environment=TDM_WEB_TRUST_PROXY=true
EnvironmentFile=-/etc/twitchdropsminer/environment

ExecStart=/opt/twitchdropsminer/.venv/bin/python /opt/twitchdropsminer/main_headless.py --stdlog

Restart=on-failure
RestartSec=10s
TimeoutStopSec=30s
KillSignal=SIGTERM

StateDirectory=twitchdropsminer
StateDirectoryMode=0700
RuntimeDirectory=twitchdropsminer
RuntimeDirectoryMode=0700
UMask=0077

StandardOutput=journal
StandardError=journal

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
RemoveIPC=true
KeyringMode=private

[Install]
WantedBy=multi-user.target
