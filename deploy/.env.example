# Copy this file to the repository root as .env before using compose.yaml.
TDM_IMAGE=twitchdropsminer-headless:local
TDM_HOST_PORT=5800
TDM_WEB_USERNAME=admin
TDM_WEB_PASSWORD_SOURCE=./deploy/secrets/web_password

# Keep both false when accessing over an SSH tunnel.
# Set both true when Caddy terminates HTTPS on the same VPS.
TDM_WEB_COOKIE_SECURE=false
TDM_WEB_TRUST_PROXY=false
